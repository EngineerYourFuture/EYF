{
  "name": "@eyf/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/jobs/judge.worker.ts",
    "dev:cron": "tsx watch src/jobs/cron.worker.ts",
    "dev:webhook": "tsx watch src/jobs/webhook.worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/jobs/judge.worker.js",
    "start:cron": "node dist/jobs/cron.worker.js",
    "start:webhook": "node dist/jobs/webhook.worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@clerk/backend": "^1.21.6",
    "@eyf/db": "workspace:*",
    "@eyf/types": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/jwt": "^10.2.0",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/sensible": "^6.0.2",
    "@react-pdf/renderer": "^4.1.5",
    "@sentry/node": "^10.65.0",
    "bullmq": "^5.32.0",
    "dotenv": "^16.4.7",
    "expo-server-sdk": "^3.10.0",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "fastify-raw-body": "^5.0.0",
    "ioredis": "^5.4.2",
    "openai": "^4.73.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "razorpay": "^2.9.5",
    "react": "^18.3.1",
    "resend": "^4.0.1",
    "svix": "^1.42.0",
    "undici": "^7.28.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@vitest/coverage-v8": "^2.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
