generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  staff
  admin
}

enum Plan {
  free
  basic
  pro
  elite
}

enum Zone {
  public
  authority
}

enum SubmissionStatus {
  accepted
  wrong_answer
  runtime_error
  time_limit_exceeded
  compilation_error
  pending
}

enum TraceStatus {
  pending
  processing
  completed
  failed
}

enum Difficulty {
  easy
  medium
  hard
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  role         Role     @default(user)
  plan         Plan     @default(free)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  emailVerified             Boolean   @default(false)
  emailVerificationToken    String?   @unique
  emailVerificationExpiry   DateTime?
  passwordResetToken        String?   @unique
  passwordResetExpiry       DateTime?

  sessions           Session[]
  refreshTokens      RefreshToken[]
  security           SecuritySettings?
  loginEvents        LoginEvent[]
  submissions        Submission[]
  executionRuns      ExecutionRun[]
  placementAttempts  PlacementAttempt[]
  mentorshipBookings MentorshipBooking[]
  resume             Resume?
  subscription       Subscription?
  analyticsEvents    AnalyticsEvent[]
  supportTickets     SupportTicket[]
  moduleProgress     ModuleProgress[]
  learningGoal       UserLearningGoal?
  techSkillProgress  TechSkillProgress[]
  recentActivity     RecentActivity[]
  techTaskAttempts   TechSkillTaskAttempt[]
  xp                 UserXP?
  dailyUsage         DailySubmissionUsage[]
  monthlyUsage       MonthlyUsage[]
  auditActorLogs     AuditLog[]             @relation("AuditActor")
  oopProgress        UserOOPProgress[]
  securityProgress   UserSecurityProgress[]
  ctfAttempts        CTFAttempt[]
  systemDesignAttempts SystemDesignAttempt[]
  careerProfile      UserCareerProfile?
  learningPaths      UserLearningPath[]
  communityPosts     CommunityPost[]
  communityVotes     CommunityVote[]
  expertProfile      ExpertProfile?
  expertReviews      ExpertReview[]
  achievements       UserAchievement[]
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  zone      Zone      @default(public)
  ip        String
  device    String
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  sessionId String
  familyId  String
  tokenHash String   @unique
  used      Boolean  @default(false)
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model SecuritySettings {
  id                   String    @id @default(uuid())
  userId               String    @unique
  totpEnabled          Boolean   @default(false)
  totpSecret           String?
  pendingTotpSecret    String?
  backupCodes          String[]
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginEvent {
  id        String   @id @default(uuid())
  userId    String
  ip        String
  device    String
  riskScore Int
  outcome   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlanEntitlement {
  id         String  @id @default(uuid())
  plan       Plan
  featureKey String
  enabled    Boolean
  limitValue Int?

  @@unique([plan, featureKey])
}

model Problem {
  id          String     @id @default(uuid())
  slug        String     @unique
  title       String
  difficulty  Difficulty
  topics      String[]
  planAccess  Plan       @default(free)
  statement   String
  examples    Json       @default("[]")
  constraints String[]
  hints       String[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  testCases   ProblemTestCase[]
  submissions Submission[]
  traces      VisualizerTrace[]
}

model ProblemTestCase {
  id             String  @id @default(uuid())
  problemId      String
  input          String
  expectedOutput String
  isHidden       Boolean @default(false)
  orderIndex     Int     @default(0)

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

model Submission {
  id         String           @id @default(uuid())
  userId     String
  problemId  String
  language   String
  sourceCode String
  status     SubmissionStatus @default(pending)
  runtimeMs  Int?
  memoryKb   Int?
  createdAt  DateTime         @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  trace   VisualizerTrace?
}

model ExecutionRun {
  id         String   @id @default(uuid())
  userId     String
  problemId  String
  language   String
  sourceCode String
  stdout     String   @default("")
  stderr     String   @default("")
  runtimeMs  Int?
  exitCode   Int
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VisualizerTrace {
  id           String      @id @default(uuid())
  submissionId String      @unique
  problemId    String
  status       TraceStatus @default(pending)
  frames       Json        @default("[]")
  retryCount   Int         @default(0)
  createdAt    DateTime    @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  problem    Problem    @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

model CoreSubjectContent {
  id         String   @id @default(uuid())
  subject    String
  topic      String
  slug       String   @unique
  title      String
  content    String
  planAccess Plan     @default(free)
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([subject, topic])
}

model PlacementAttempt {
  id        String   @id @default(uuid())
  userId    String
  company   String
  role      String
  kind      String
  outcome   String?
  notes     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MentorshipBooking {
  id          String   @id @default(uuid())
  userId      String
  mentorId    String
  scheduledAt DateTime
  month       String
  status      String   @default("booked")
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Resume {
  id        String   @id @default(uuid())
  userId    String   @unique
  template  String   @default("default")
  dataJson  Json     @default("{}")
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id            String   @id @default(uuid())
  userId        String   @unique
  plan          Plan
  status        String   @default("active")
  periodStart   DateTime
  periodEnd     DateTime
  providerSubId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BillingEvent {
  id              String   @id @default(uuid())
  providerEventId String   @unique
  type            String
  userId          String?
  payload         Json
  processedAt     DateTime @default(now())
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  userId    String
  eventType String
  payload   Json     @default("{}")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id        String   @id @default(uuid())
  userId    String
  subject   String
  body      String
  status    String   @default("open")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String
  actorRole    Role
  action       String
  resourceType String
  resourceId   String
  createdAt    DateTime @default(now())

  actor User @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)
}

model ModuleProgress {
  id             String   @id @default(uuid())
  userId         String
  moduleKey      String
  completionPct  Float    @default(0)
  status         String   @default("not_started")
  lastActivityAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleKey])
}

model UserLearningGoal {
  id              String   @id @default(uuid())
  userId          String   @unique
  targetRole      String   @default("Software Engineer")
  priorityModules String[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TechSkillProgress {
  id       String @id @default(uuid())
  userId   String
  skillKey String
  level    Int    @default(1)
  xp       Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillKey])
}

model RecentActivity {
  id        String   @id @default(uuid())
  userId    String
  moduleKey String
  action    String
  payload   Json     @default("{}")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TechSkillTaskAttempt {
  id       String  @id @default(uuid())
  userId   String
  taskKey  String
  status   String  @default("not_started")
  evidence String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskKey])
}

model UserXP {
  id               String    @id @default(uuid())
  userId           String    @unique
  totalXp          Int       @default(0)
  weeklyXp         Int       @default(0)
  streak           Int       @default(0)
  longestStreak    Int       @default(0)
  lastActivityDate DateTime?
  weeklyResetAt    DateTime?

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievements UserAchievement[]
}

model Achievement {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String
  icon        String
  category    String   // dsa | oop | security | community | consistency | career
  xpReward    Int      @default(0)
  rarity      String   @default("common") // common | rare | epic | legendary
  createdAt   DateTime @default(now())

  earnedBy UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String
  xpId          String?
  earnedAt      DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id])
  xp          UserXP?     @relation(fields: [xpId], references: [id])

  @@unique([userId, achievementId])
}

model DailySubmissionUsage {
  id     String @id @default(uuid())
  userId String
  date   String
  count  Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model MonthlyUsage {
  id             String @id @default(uuid())
  userId         String
  month          String
  mentorshipUsed Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
}

// ── OOP & Software Engineering ──────────────────────────────────────────────

model DesignPatternLesson {
  id          String   @id @default(uuid())
  patternKey  String   @unique
  name        String
  category    String   // creational | structural | behavioral
  description String
  intent      String
  structure   String
  codeExample String
  useCase     String
  relatedPatterns String[]
  planAccess  Plan     @default(free)
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())

  progress UserOOPProgress[]
}

model UserOOPProgress {
  id          String    @id @default(uuid())
  userId      String
  patternId   String
  status      String    @default("not_started") // not_started | in_progress | completed
  completedAt DateTime?

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  pattern DesignPatternLesson @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@unique([userId, patternId])
}

model SolidPrincipleLesson {
  id          String   @id @default(uuid())
  principleKey String  @unique
  letter      String   // S | O | L | I | D
  title       String
  description String
  badExample  String
  goodExample String
  planAccess  Plan     @default(free)
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
}

// ── Cybersecurity ────────────────────────────────────────────────────────────

model SecurityLesson {
  id          String     @id @default(uuid())
  lessonKey   String     @unique
  title       String
  category    String     // web | network | crypto | forensics | owasp | cloud | malware
  description String
  content     String
  difficulty  Difficulty
  planAccess  Plan       @default(free)
  orderIndex  Int        @default(0)
  createdAt   DateTime   @default(now())

  progress UserSecurityProgress[]
}

model UserSecurityProgress {
  id          String    @id @default(uuid())
  userId      String
  lessonId    String
  status      String    @default("not_started")
  completedAt DateTime?

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson SecurityLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model CTFChallenge {
  id           String     @id @default(uuid())
  challengeKey String     @unique
  title        String
  category     String     // web | crypto | forensics | pwn | reverse | misc
  difficulty   Difficulty
  description  String
  points       Int        @default(100)
  hints        String[]
  flagHash     String
  planAccess   Plan       @default(free)
  createdAt    DateTime   @default(now())

  attempts CTFAttempt[]
}

model CTFAttempt {
  id          String    @id @default(uuid())
  userId      String
  challengeId String
  solved      Boolean   @default(false)
  attempts    Int       @default(0)
  solvedAt    DateTime?
  createdAt   DateTime  @default(now())

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge CTFChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
}

// ── System Design ─────────────────────────────────────────────────────────────

model SystemDesignQuestion {
  id          String     @id @default(uuid())
  slug        String     @unique
  title       String
  category    String     // scalability | database | microservices | caching | messaging | api
  difficulty  Difficulty
  description String
  approach    String
  components  Json       @default("[]")
  tradeoffs   String
  planAccess  Plan       @default(free)
  createdAt   DateTime   @default(now())

  attempts SystemDesignAttempt[]
}

model SystemDesignAttempt {
  id         String   @id @default(uuid())
  userId     String
  questionId String
  response   String
  createdAt  DateTime @default(now())

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  question SystemDesignQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// ── Career & Learning Paths ───────────────────────────────────────────────────

model UserCareerProfile {
  id              String    @id @default(uuid())
  userId          String    @unique
  track           String    @default("student") // student | professional | expert
  currentRole     String?
  targetRole      String?
  experienceYears Int       @default(0)
  currentCompany  String?
  linkedinUrl     String?
  githubUrl       String?
  skills          String[]
  interests       String[]
  targetTimeline  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LearningPath {
  id             String   @id @default(uuid())
  slug           String   @unique
  title          String
  description    String
  targetTrack    String   // student | professional | expert
  targetRole     String?
  modules        Json     @default("[]")
  estimatedWeeks Int      @default(4)
  planAccess     Plan     @default(free)
  createdAt      DateTime @default(now())

  enrollments UserLearningPath[]
}

model UserLearningPath {
  id          String    @id @default(uuid())
  userId      String
  pathId      String
  startedAt   DateTime  @default(now())
  progress    Float     @default(0)
  completedAt DateTime?

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  path LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@unique([userId, pathId])
}

// ── Community ─────────────────────────────────────────────────────────────────

model CommunityPost {
  id        String   @id @default(uuid())
  userId    String
  parentId  String?
  title     String?
  body      String
  category  String   @default("general") // general | dsa | oop | security | system-design | career
  tags      String[]
  upvotes   Int      @default(0)
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  CommunityPost?  @relation("PostReplies", fields: [parentId], references: [id])
  replies CommunityPost[] @relation("PostReplies")
  votes   CommunityVote[]
}

model CommunityVote {
  id     String @id @default(uuid())
  userId String
  postId String
  vote   Int

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

// ── Expert Network ────────────────────────────────────────────────────────────

model ExpertProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  displayName     String
  title           String
  company         String?
  bio             String
  specializations String[]
  yearsExperience Int      @default(0)
  linkedinUrl     String?
  githubUrl       String?
  available       Boolean  @default(true)
  hourlyRate      Int?
  rating          Float    @default(0)
  reviewCount     Int      @default(0)
  createdAt       DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews ExpertReview[]
}

model ExpertReview {
  id        String   @id @default(uuid())
  userId    String
  expertId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  expert ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)

  @@unique([userId, expertId])
}
