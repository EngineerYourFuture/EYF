APP_NAME=eyf-api
NODE_ENV=production
PORT=3000
TRUST_PROXY=true
SERVE_FRONTEND=true
CORS_ALLOWED_ORIGINS=https://your-domain.com

DATABASE_URL=postgres://user:password@postgres:5432/eyf
JWT_ACCESS_SECRET=replace-with-very-strong-access-secret
JWT_REFRESH_SECRET=replace-with-very-strong-refresh-secret
BILLING_WEBHOOK_SECRET=replace-with-very-strong-webhook-secret
