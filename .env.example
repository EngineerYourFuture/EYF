# EYF environment — copy to .env and fill in.
#
# Variables are grouped by EXPOSURE, not by feature, so it is obvious what may
# reach the browser and what must never leave the server:
#
#   1. PUBLIC        — NEXT_PUBLIC_*; inlined into the client bundle at build time.
#                      NEVER put a secret here — it ships to every visitor.
#   2. BACKEND SECRETS — server-only credentials. Must NOT be prefixed NEXT_PUBLIC_.
#   3. BACKEND CONFIG  — server-only, non-secret runtime settings.
#   4. SHARED/INFRA    — connection strings and infra used across services.
#
# The API validates its variables at boot (apps/api/src/env.ts, Zod). Missing or
# malformed required values fail fast; optional integrations no-op without keys.


# ══════════════════════════════════════════════════════════════════
# 1. PUBLIC — exposed to the browser (build-time inlined). NO SECRETS.
# ══════════════════════════════════════════════════════════════════
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Clerk PUBLISHABLE key — safe to expose (it is public by Clerk's design).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace
# PostHog PROJECT key — public by design (analytics ingestion key).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com


# ══════════════════════════════════════════════════════════════════
# 2. BACKEND SECRETS — server-only. Never prefix these with NEXT_PUBLIC_.
# ══════════════════════════════════════════════════════════════════

# ── Internal session JWT (Fastify, alongside Clerk) ───────────────
# 32+ chars each, and they MUST differ. Generate: openssl rand -hex 32
JWT_ACCESS_SECRET=dev-only-replace-with-32-char-secret-string
JWT_REFRESH_SECRET=dev-only-replace-with-32-char-refresh-string

# ── Auth (Clerk) — SECRET side ────────────────────────────────────
CLERK_SECRET_KEY=sk_test_replace
CLERK_PUBLISHABLE_KEY=pk_test_replace
CLERK_WEBHOOK_SECRET=whsec_replace

# ── Payments (Razorpay) ───────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_replace
RAZORPAY_KEY_SECRET=replace
RAZORPAY_WEBHOOK_SECRET=replace

# ── LLM (Anthropic Claude) — mocks, grading, coaching, editorial ──
ANTHROPIC_API_KEY=sk-ant-replace

# ── Speech-to-text (OpenAI Whisper) — SERVER-SIDE ONLY ────────────
# Consumed by the API (services/whisper.ts). It is NOT a NEXT_PUBLIC_ var and
# must never be exposed to the browser.
OPENAI_API_KEY=

# ── Email (Resend transactional) ──────────────────────────────────
RESEND_API_KEY=re_replace
RESEND_FROM=noreply@eyf.in

# ── Code Judge (Judge0 self-hosted) ───────────────────────────────
JUDGE0_TOKEN=

# ── Storage (Cloudflare R2) — S3-compatible ───────────────────────
# Optional (object storage not wired yet). Validated when present.
R2_ACCOUNT_ID=replace
R2_ACCESS_KEY=replace
R2_SECRET_KEY=replace
R2_BUCKET=eyf-uploads
R2_PUBLIC_URL=https://cdn.eyf.in

# ── Admin portal second gate — staff enter this code after login ──
# Unset = gate disabled (dev). Set a strong value in production.
ADMIN_ACCESS_CODE=

# ── Observability ─────────────────────────────────────────────────
SENTRY_DSN=
# If set, GET /metrics requires `Authorization: Bearer <token>`.
METRICS_TOKEN=


# ══════════════════════════════════════════════════════════════════
# 3. BACKEND CONFIG — server-only, non-secret runtime settings.
# ══════════════════════════════════════════════════════════════════
NODE_ENV=development

# Dev-only email login (no password). Local only — NEVER set in production.
DEV_LOGIN_ENABLED=true

# Master switch for paywalls. Off until Razorpay goes live, so the app is fully
# usable on the free tier; set true to enable plan gating.
BILLING_ENABLED=false

# API server.
API_PORT=4000
API_HOST=0.0.0.0
API_CORS_ORIGINS=http://localhost:3000
API_LOG_LEVEL=info
# Number of trusted proxy hops (LB/CDN) in front of the API. 1 behind a single
# load balancer; raise it if you add Cloudflare in front of that LB.
TRUST_PROXY_HOPS=1

# Judge0 base URL (non-secret; keep on a private network in production).
JUDGE0_URL=http://localhost:2358

# Observability tuning (non-secret).
SENTRY_TRACES_SAMPLE_RATE=0.1
RELEASE=dev


# ══════════════════════════════════════════════════════════════════
# 4. SHARED / INFRA — connection strings used across services.
# ══════════════════════════════════════════════════════════════════

# ── Database (Postgres / Neon) ────────────────────────────────────
# Runtime uses the POOLED endpoint (PgBouncer / Neon pooled / Prisma Accelerate).
DATABASE_URL=postgresql://eyf:eyf@localhost:5432/eyf?schema=public
# Direct (non-pooled) connection for migrations/DDL. In prod point this at the
# unpooled 5432 endpoint; locally it can equal DATABASE_URL.
DIRECT_DATABASE_URL=postgresql://eyf:eyf@localhost:5432/eyf?schema=public

# ── Cache (Redis / Upstash) ───────────────────────────────────────
REDIS_URL=redis://localhost:6379
