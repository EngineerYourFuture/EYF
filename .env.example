# ── Core ──────────────────────────────────────────────────────────
NODE_ENV=development
# Dev-only email login (no password). Local only — NEVER set in production.
DEV_LOGIN_ENABLED=true

# ── Database (Postgres / Neon) ────────────────────────────────────
DATABASE_URL=postgresql://eyf:eyf@localhost:5432/eyf?schema=public

# ── Cache (Redis / Upstash) ───────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── API ───────────────────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0
API_CORS_ORIGINS=http://localhost:3000
API_LOG_LEVEL=info

# ── Web (Next.js) ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
OPENAI_API_KEY=

# ── Auth (Clerk) ──────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_replace
CLERK_PUBLISHABLE_KEY=pk_test_replace
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace
CLERK_WEBHOOK_SECRET=whsec_replace

# ── Payments (Razorpay) ───────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_replace
RAZORPAY_KEY_SECRET=replace
RAZORPAY_WEBHOOK_SECRET=replace

# ── Code Judge (Judge0 self-hosted) ───────────────────────────────
JUDGE0_URL=http://localhost:2358
JUDGE0_TOKEN=

# ── LLM (Anthropic Claude) ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-replace

# ── SMS / OTP (MSG91 — India) ─────────────────────────────────────
MSG91_AUTH_KEY=replace
MSG91_SENDER_ID=EYFAPP
MSG91_TEMPLATE_ID=replace

# ── Email (Resend transactional) ──────────────────────────────────
RESEND_API_KEY=re_replace
RESEND_FROM=noreply@eyf.in

# ── Storage (Cloudflare R2) ───────────────────────────────────────
R2_ACCOUNT_ID=replace
R2_ACCESS_KEY=replace
R2_SECRET_KEY=replace
R2_BUCKET=eyf-uploads
R2_PUBLIC_URL=https://cdn.eyf.in

# ── Auth tokens (internal session JWT for Fastify, alongside Clerk) ─
JWT_ACCESS_SECRET=dev-only-replace-with-32-char-secret-string
JWT_REFRESH_SECRET=dev-only-replace-with-32-char-refresh-string
