# ── Core ──────────────────────────────────────────────────────────
NODE_ENV=development
# Dev-only email login (no password). Local only — NEVER set in production.
DEV_LOGIN_ENABLED=true

# ── Database (Postgres / Neon) ────────────────────────────────────
# Runtime uses the POOLED endpoint (PgBouncer / Neon pooled / Prisma Accelerate).
DATABASE_URL=postgresql://eyf:eyf@localhost:5432/eyf?schema=public
# Direct (non-pooled) connection for migrations/DDL. In prod point this at the
# unpooled 5432 endpoint; locally it can equal DATABASE_URL. Optional in dev.
DIRECT_DATABASE_URL=postgresql://eyf:eyf@localhost:5432/eyf?schema=public

# ── Cache (Redis / Upstash) ───────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── API ───────────────────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0
API_CORS_ORIGINS=http://localhost:3000
API_LOG_LEVEL=info
# Number of trusted proxy hops (LB/CDN) in front of the API. 1 behind a single
# load balancer; raise it if you add Cloudflare in front of that LB.
TRUST_PROXY_HOPS=1

# ── Observability (optional — all features no-op without values) ───
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
RELEASE=dev
# If set, GET /metrics requires `Authorization: Bearer <token>`.
METRICS_TOKEN=

# ── Web (Next.js) ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
OPENAI_API_KEY=

# ── Auth (Clerk) ──────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_replace
CLERK_PUBLISHABLE_KEY=pk_test_replace
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace
CLERK_WEBHOOK_SECRET=whsec_replace

# ── Payments (Razorpay) ───────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_replace
RAZORPAY_KEY_SECRET=replace
RAZORPAY_WEBHOOK_SECRET=replace

# ── Code Judge (Judge0 self-hosted) ───────────────────────────────
JUDGE0_URL=http://localhost:2358
JUDGE0_TOKEN=

# ── LLM (Anthropic Claude) ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-replace

# ── Email (Resend transactional) ──────────────────────────────────
RESEND_API_KEY=re_replace
RESEND_FROM=noreply@eyf.in

# ── Storage (Cloudflare R2) ───────────────────────────────────────
R2_ACCOUNT_ID=replace
R2_ACCESS_KEY=replace
R2_SECRET_KEY=replace
R2_BUCKET=eyf-uploads
R2_PUBLIC_URL=https://cdn.eyf.in

# ── Auth tokens (internal session JWT for Fastify, alongside Clerk) ─
JWT_ACCESS_SECRET=dev-only-replace-with-32-char-secret-string
JWT_REFRESH_SECRET=dev-only-replace-with-32-char-refresh-string

# Admin portal second gate — staff enter this code after login. Unset = disabled.
ADMIN_ACCESS_CODE=
