// EYF — Engineer Your Future
// Phase 1 schema. 15 core tables per specs/EYF_Master_Docs_Final.md (Doc 11).
// Keep additions backward-compatible — migrations are the contract.

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Runtime uses the POOLED endpoint (PgBouncer / Neon pooled / Prisma Accelerate)
  // so N app + worker instances don't exhaust Postgres connections. Migrations
  // and introspection use directUrl, which must bypass the pooler (transaction
  // pooling can't run DDL). When DIRECT_DATABASE_URL is unset, Prisma falls back
  // to url — safe for single-node/local dev.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────

enum Role {
  GUEST
  STUDENT_FREE
  STUDENT_BASIC
  STUDENT_PRO
  STUDENT_ELITE
  MENTOR
  MODERATOR
  CONTENT_CREATOR
  ADMIN
}

enum Persona {
  STUDENT   // 0–2 yrs: placements, DSA, core subjects
  SWITCHER  // 1–5 yrs: system design, behavioral, resume, comp
  DEVELOPER // architecture, projects, AI engineering, leadership
}

enum PlanTier {
  FREE
  BASIC
  PRO
  ELITE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  PAUSED
  TRIALING
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

enum Verdict {
  PENDING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT
  MEMORY_LIMIT
  RUNTIME_ERROR
  COMPILE_ERROR
  INTERNAL_ERROR
}

enum Language {
  CPP
  JAVA
  PYTHON
  JAVASCRIPT
  TYPESCRIPT
  GO
  C
  RUST
  KOTLIN
  CSHARP
}

enum MockType {
  AI
  PEER
  EXPERT
}

enum MockStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELED
  NO_SHOW
}

enum CertificateType {
  PATTERN
  TRACK
  COMPANY_READY
  MOCK_GRADE
  ASSESSMENT
}

enum CognitiveGame {
  REACTION
  PATTERN_RECALL
  N_BACK
  SPATIAL
  STROOP
}

enum Subject {
  OS
  DBMS
  CN
  OOP
}

enum BadgeTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum JobRole {
  SDE
  FULLSTACK
  BACKEND
  FRONTEND
  DATA
  ML
  DEVOPS
  ANDROID
  IOS
  QA
  PM
  DESIGN
}

enum ApplicationStatus {
  SAVED
  APPLIED
  OA
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

enum DemandLevel {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum InternshipDuration {
  MONTHS_2
  MONTHS_3
  MONTHS_6
  SEMESTER
  FULL_YEAR
}

enum InternshipStatus {
  SAVED
  APPLIED
  SELECTED
  REJECTED
  CONVERTED_PPO
}

enum ReactionKind {
  LIKE
  HELPFUL
  FIRE
  DISAGREE
}

enum ForumCategory {
  GENERAL
  PLACEMENTS
  DSA
  CORE_SUBJECTS
  PROJECTS
  RESUME
  INTERVIEWS
  OFF_TOPIC
}

// ─── 1. Users ─────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  clerkId         String    @unique
  email           String    @unique
  phone           String?   @unique
  name            String
  college         String?
  graduationYear  Int?
  targetRole      String?
  persona         Persona?  // STUDENT | SWITCHER | DEVELOPER — tailors the journey
  role            Role      @default(STUDENT_FREE)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  profile         UserProfile?
  subscription    Subscription?
  solutions       ProblemSolution[]
  roadmaps        UserRoadmap[]
  streaks         DailyStreak[]
  sessions        UserSession[]
  assessments     AssessmentSession[]
  cognitive       CognitiveSession[]
  mocksAsCandidate MockSession[]    @relation("mock_candidate")
  mocksAsPeer     MockSession[]     @relation("mock_peer")
  mentor          Mentor?
  certificates    Certificate[]
  flashcardReviews FlashcardReview[]
  resumes         Resume[]
  badges          UserBadge[]
  userProjects    UserProject[]
  jobApplications JobApplication[]
  tracks          UserTrack[]
  forumThreads    ForumThread[]
  forumPosts      ForumPost[]
  forumReactions  ForumReaction[]
  internships     UserInternship[]
  oaReports       OaReport[]
  pressureSessions PressureSession[]
  peerQueue       PeerQueue?
  pushTokens      PushToken[]
  missionDays     MissionDay[]
  interviewExperiences InterviewExperience[]
  mcqAttempts     McqAttempt[]
  communicationDrills CommunicationDrill[]
  projectPreps    ProjectPrep[]
  scoreShares     ScoreShare[]
  orgMemberships  OrgMember[]
  talentConsent   TalentConsent?

  @@index([role])
  @@index([college])
  @@map("users")
}

// ─── Daily Mission claim (idempotent bonus XP, one per day) ───────────
model MissionDay {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime  @db.Date
  bonusXp   Int       @default(0)
  claimedAt DateTime  @default(now())

  @@unique([userId, date])
  @@index([userId, date])
  @@map("mission_days")
}

// ─── 2. UserProfile ───────────────────────────────────────────────

model UserProfile {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatar       String?
  bio          String?
  githubUrl    String?
  linkedinUrl  String?
  leetcodeUrl  String?
  resumeUrl    String?
  currentXp    Int      @default(0)
  level        Int      @default(1)
  streakDays   Int      @default(0)
  longestStreak Int     @default(0)
  totalSolved  Int      @default(0)
  preferredLanguage Language @default(CPP)
  timezone     String   @default("Asia/Kolkata")
  updatedAt    DateTime @updatedAt

  @@map("user_profiles")
}

// ─── 3. Subscription ──────────────────────────────────────────────

model Subscription {
  id              String             @id @default(cuid())
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            PlanTier           @default(FREE)
  status          SubscriptionStatus @default(ACTIVE)
  razorpaySubId   String?            @unique
  razorpayPlanId  String?
  startedAt       DateTime           @default(now())
  endsAt          DateTime?
  canceledAt      DateTime?
  trialEndsAt     DateTime?
  amountInr       Int                @default(0) // paisa
  intervalMonths  Int                @default(1)
  // created_at of the last-applied webhook event — guards against out-of-order delivery.
  lastEventAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  invoices        Invoice[]

  @@index([plan, status])
  @@map("subscriptions")
}

model Invoice {
  id              String       @id @default(cuid())
  subscriptionId  String
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  razorpayInvoiceId String?    @unique
  amountInr       Int
  gstInr          Int          @default(0)
  status          String       // paid | failed | issued
  paidAt          DateTime?
  createdAt       DateTime     @default(now())

  @@index([subscriptionId])
  @@map("invoices")
}

// ─── 4. Problem ───────────────────────────────────────────────────

model Problem {
  id              String      @id @default(cuid())
  slug            String      @unique
  title           String
  description     String      // markdown
  difficulty      Difficulty
  topics          String[]
  patterns        String[]
  companies       String[]    // e.g. ["amazon", "flipkart"]
  premium         Boolean     @default(false)
  acceptanceRate  Float       @default(0)
  totalSubmissions Int        @default(0)
  totalAccepted   Int         @default(0)
  timeLimitMs     Int         @default(2000)
  memoryLimitKb   Int         @default(262144)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  testCases       TestCase[]
  solutions       ProblemSolution[]
  editorial       Editorial?
  variants        ProblemVariant[]
  starterCode     StarterCode[]
  pressureSessions PressureSession[]

  @@index([difficulty])
  @@index([patterns])
  @@index([companies])
  @@map("problems")
}

model StarterCode {
  id          String   @id @default(cuid())
  problemId   String
  problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  language    Language
  code        String

  @@unique([problemId, language])
  @@map("starter_code")
}

// ─── 5. TestCase ──────────────────────────────────────────────────

model TestCase {
  id          String   @id @default(cuid())
  problemId   String
  problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  input       String
  expected    String
  isPublic    Boolean  @default(false)
  weight      Int      @default(1)
  orderIndex  Int      @default(0)

  @@index([problemId])
  @@map("test_cases")
}

// ─── 6. ProblemSolution (submission) ──────────────────────────────

model ProblemSolution {
  id          String   @id @default(cuid())
  problemId   String
  problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language    Language
  code        String
  verdict     Verdict  @default(PENDING)
  runtimeMs   Int?
  memoryKb    Int?
  passedTests Int      @default(0)
  totalTests  Int      @default(0)
  errorMsg    String?
  judge0Token String?
  submittedAt DateTime @default(now())

  @@index([userId, submittedAt])
  @@index([problemId, verdict])
  @@map("problem_solutions")
}

// ─── 7. Editorial ─────────────────────────────────────────────────

model Editorial {
  problemId    String   @id
  problem      Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  textSolution String   // markdown
  videoUrl     String?
  timeComplexity  String
  spaceComplexity String
  approach     String?
  pitfalls     String?
  updatedAt    DateTime @updatedAt

  @@map("editorials")
}

// ─── 8. ProblemVariant (Claude-generated twists) ──────────────────

model ProblemVariant {
  id               String   @id @default(cuid())
  problemId        String
  problem          Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  title            String
  description      String
  twistExplanation String
  generatedBy      String   @default("claude-sonnet")
  createdAt        DateTime @default(now())

  @@index([problemId])
  @@map("problem_variants")
}

// ─── 9. UserRoadmap ───────────────────────────────────────────────

model UserRoadmap {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateSlug String   // "personalized" for generated plans; else a template slug
  currentDay   Int      @default(1)
  completionPct Float   @default(0)
  startedAt    DateTime @default(now())
  targetDate   DateTime?
  completedAt  DateTime?

  // Personalized Roadmap Engine output
  title         String?
  targetRole    String?
  targetCompany String?
  weeks         Int?
  hoursPerDay   Int?
  plan          Json?    // GeneratedPlan.plan — week-by-week

  @@index([userId])
  @@map("user_roadmaps")
}

// ─── 10. DailyStreak ──────────────────────────────────────────────

model DailyStreak {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime @db.Date
  problemsSolved  Int      @default(0)
  minutesSpent    Int      @default(0)
  xpEarned        Int      @default(0)
  moodScore       Int? // 1-5 optional

  @@unique([userId, date])
  @@index([userId, date])
  @@map("daily_streaks")
}

// ─── 11. AssessmentSession ────────────────────────────────────────

model AssessmentSession {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalQuestions   Int
  correctAnswers   Int
  gapAnalysis      Json // { dsa: 0-100, oop: ..., cn: ..., aptitude: ... }
  placementProbability Json // { realistic: {company, prob}, stretch: ..., dream: ... }
  durationSeconds  Int
  completedAt      DateTime @default(now())

  @@index([userId])
  @@map("assessment_sessions")
}

// ─── 12. CognitiveSession ─────────────────────────────────────────

model CognitiveSession {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  game            CognitiveGame
  score           Int
  accuracyPct     Float
  tabSwitchCount  Int           @default(0)
  durationSeconds Int
  playedAt        DateTime      @default(now())

  @@index([userId, game])
  @@map("cognitive_sessions")
}

// ─── 13. MockSession ──────────────────────────────────────────────

model MockSession {
  id            String     @id @default(cuid())
  type          MockType
  status        MockStatus @default(SCHEDULED)
  candidateId   String
  candidate     User       @relation("mock_candidate", fields: [candidateId], references: [id], onDelete: Cascade)
  peerId        String?
  peer          User?      @relation("mock_peer", fields: [peerId], references: [id])
  mentorId      String?
  mentor        Mentor?    @relation(fields: [mentorId], references: [id])
  company       String?
  durationMin   Int        @default(45)
  scheduledFor  DateTime
  startedAt     DateTime?
  endedAt       DateTime?
  feedback      Json? // { strengths[], improvements[], score, rubric }
  transcript    Json? // [{role, content, ts}]
  transcriptUrl String? // R2 link for full recording transcript
  recordingUrl  String?
  problemFocus  String? // e.g. "binary-search", "system-design"
  createdAt     DateTime   @default(now())

  @@index([candidateId])
  @@index([mentorId])
  @@index([status, scheduledFor])
  @@map("mock_sessions")
}

// ─── 14. Mentor ───────────────────────────────────────────────────

model Mentor {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company       String
  jobTitle      String
  yearsExp      Int
  expertise     String[] // ["system-design","backend","fang-interviews"]
  hourlyRateInr Int      @default(0)
  bio           String?
  ratingAvg     Float    @default(0)
  ratingCount   Int      @default(0)
  verified      Boolean  @default(false)
  verifiedAt    DateTime?
  verificationDocs String[] // R2 keys
  razorpayAccountId String? @unique // Razorpay Connect linked account
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  mocks         MockSession[]
  slots         MentorSlot[]
  payouts       MentorPayout[]

  @@index([company, verified])
  @@map("mentors")
}

model MentorSlot {
  id          String       @id @default(cuid())
  mentorId    String
  mentor      Mentor       @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  startAt     DateTime
  endAt       DateTime
  booked      Boolean      @default(false)
  mockSessionId String?    @unique
  createdAt   DateTime     @default(now())

  @@index([mentorId, startAt])
  @@map("mentor_slots")
}

// ─── 15. Certificate ──────────────────────────────────────────────

model Certificate {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             CertificateType
  title            String
  score            Int?
  metadata         Json? // pattern slug, track, company, mock id, etc.
  verificationCode String          @unique
  pdfUrl           String?
  linkedinShared   Boolean         @default(false)
  issuedAt         DateTime        @default(now())
  // Enterprise (PRD §15.9): org-issued, skill-anchored, revocable.
  orgId            String?
  templateId       String?
  skillsAsserted   Json? // [{ slug, level }] — what this cert vouches for
  revokedAt        DateTime?
  revokeReason     String?

  @@index([userId])
  @@index([orgId])
  @@map("certificates")
}

// Certificate template (PRD §15.9). Criteria compile to auto-issue: pass a
// blueprint's run at/above its bar, or manual issue by a reviewer.
enum CertCriteria {
  ASSESSMENT_PASS
  MANUAL
}

model CertificateTemplate {
  id             String       @id @default(cuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name           String
  skills         Json // [{ slug, level }] asserted on issue
  criteria       CertCriteria @default(MANUAL)
  blueprintId    String? // when criteria = ASSESSMENT_PASS
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@index([orgId])
  @@map("org_certificate_templates")
}

// ─── MCQ question bank (staff-authored; replaces the hardcoded TS bank) ───

model McqBankQuestion {
  id           String      @id @default(cuid())
  sourceId     String?     @unique // id from the legacy TS bank (idempotent import)
  category     McqCategory
  topic        String
  difficulty   String      @default("medium") // easy | medium | hard
  prompt       String
  choices      String[]
  correctIndex Int
  explanation  String
  companies    String[]    // recruiter patterns this question drills (TCS, Infosys…)
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([category, active])
  @@map("mcq_bank_questions")
}

// ─── Assessment question bank (staff-authored; replaces the hardcoded TS bank) ───

model AssessmentBankQuestion {
  id           String   @id @default(cuid())
  sourceId     String?  @unique // id from the legacy TS bank (idempotent import)
  area         String   // dsa | cs | aptitude
  topic        String
  difficulty   String   @default("medium") // easy | medium | hard
  prompt       String
  choices      String[]
  correctIndex Int
  explanation  String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([area, active])
  @@map("assessment_bank_questions")
}

// ─── Communication drill prompts (staff-authored; replaces the hardcoded TS bank) ───

model CommunicationPromptBank {
  id        String            @id @default(cuid())
  sourceId  String?           @unique
  kind      CommunicationKind
  question  String
  tip       String
  covers    String[] // rubric checklist a strong answer must hit (anchors the AI grader)
  active    Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([kind, active])
  @@map("communication_prompt_bank")
}

// ─── Company aptitude-sim blueprints (staff-authored; replaces the hardcoded TS list) ───

model CompanySimBlueprint {
  id        String   @id @default(cuid())
  slug      String   @unique
  company   String
  label     String
  blurb     String
  usedBy    String
  sections  Json     // [{ name, category: McqCategory, questions, minutes }]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("company_sim_blueprints")
}

// ─── EYF Knowledge Base — original Q&A content, owned by EYF ──────────
// Students ask tech-stack questions; EYF Intelligence (Claude) writes an
// ORIGINAL placement-angled answer which is stored here. Staff curate in the
// portal. Repeat questions are served from this base — EYF's own corpus
// compounds with usage. No third-party content is ingested or republished.

enum KnowledgeSource {
  AI    // generated by EYF Intelligence, pending staff review
  STAFF // written or edited by staff in the portal
}

model KnowledgeEntry {
  id        String          @id @default(cuid())
  question  String
  answer    String          // markdown, EYF's own voice
  topic     String          // e.g. "node", "react", "system-design"
  tags      String[]
  source    KnowledgeSource @default(AI)
  reviewed  Boolean         @default(false) // staff sign-off flag
  active    Boolean         @default(true)
  askCount  Int             @default(1) // how many students hit this entry
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([topic, active])
  @@map("knowledge_entries")
}

// ─── Shareable EYF Score snapshot (server-computed, publicly verifiable) ───

model ScoreShare {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String   @unique
  snapshot  Json // { overall, band, pillars[], name, college, graduationYear, targetRole, targetCompany }
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("score_shares")
}

// ─── 16. TheoryNote (Core Subjects) ───────────────────────────────

model TheoryNote {
  id          String   @id @default(cuid())
  slug        String   @unique
  subject     Subject
  title       String
  content     String   // markdown
  orderIndex  Int      @default(0)
  premium     Boolean  @default(false) // false for OS (free tier per spec)
  estMinutes  Int      @default(10)
  updatedAt   DateTime @updatedAt

  @@index([subject, orderIndex])
  @@map("theory_notes")
}

// ─── 17. Flashcard + SRS (SM-2) ───────────────────────────────────

model Flashcard {
  id          String   @id @default(cuid())
  subject     Subject
  topic       String
  front       String
  back        String
  difficulty  Difficulty @default(MEDIUM)
  createdAt   DateTime @default(now())

  reviews     FlashcardReview[]

  @@index([subject, topic])
  @@map("flashcards")
}

model FlashcardReview {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcardId  String
  flashcard    Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  easiness     Float    @default(2.5)
  interval     Int      @default(0) // days
  repetitions  Int      @default(0)
  dueAt        DateTime @default(now())
  lastReviewedAt DateTime?

  @@unique([userId, flashcardId])
  @@index([userId, dueAt])
  @@map("flashcard_reviews")
}

// ─── 18. Resume ───────────────────────────────────────────────────

model Resume {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String   @default("My Resume")
  json        Json     // ResumeDocument shape — see @eyf/types
  template    String   @default("classic")
  atsScore    Int?     // 0-100
  atsBreakdown Json?
  pdfUrl      String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("resumes")
}

// ─── 19. Badge + UserBadge ────────────────────────────────────────

model Badge {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String
  tier        BadgeTier @default(BRONZE)
  icon        String    @default("trophy")
  xpReward    Int       @default(50)
  awards      UserBadge[]

  @@map("badges")
}

model UserBadge {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId     String
  badge       Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt    DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
  @@map("user_badges")
}

// ─── 20. BTech Projects ───────────────────────────────────────────

model ProjectIdea {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  description String
  techStack   String[]
  difficulty  Difficulty @default(MEDIUM)
  weeks       Int        @default(4)
  tags        String[]
  outcomes    String[]   // "deploy to vercel", "auth flow", etc.
  premium     Boolean    @default(false)
  createdAt   DateTime   @default(now())

  userProjects UserProject[]

  @@index([difficulty])
  @@map("project_ideas")
}

model UserProject {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ideaId        String
  idea          ProjectIdea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  status        ProjectStatus @default(PLANNED)
  githubUrl     String?
  liveUrl       String?
  notes         String?
  startedAt     DateTime      @default(now())
  completedAt   DateTime?

  @@unique([userId, ideaId])
  @@index([userId])
  @@map("user_projects")
}

// ─── 21. Jobs ─────────────────────────────────────────────────────

model Job {
  id            String     @id @default(cuid())
  slug          String     @unique
  company       String
  title         String
  role          JobRole
  location      String
  remote        Boolean    @default(false)
  salaryMinInr  Int?
  salaryMaxInr  Int?
  experienceMin Int        @default(0)
  description   String
  applyUrl      String
  source        String     @default("manual") // manual | scraped | partner
  postedAt      DateTime   @default(now())
  closesAt      DateTime?
  isActive      Boolean    @default(true)

  applications  JobApplication[]

  @@index([role, isActive])
  @@index([company])
  @@map("jobs")
}

model JobApplication {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId        String
  job          Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status       ApplicationStatus @default(SAVED)
  notes        String?
  appliedAt    DateTime?
  updatedAt    DateTime          @updatedAt
  createdAt    DateTime          @default(now())

  @@unique([userId, jobId])
  @@index([userId, status])
  @@map("job_applications")
}

// ─── 22. Career Tracks ────────────────────────────────────────────

model CareerTrack {
  id              String      @id @default(cuid())
  slug            String      @unique
  name            String
  tagline         String
  description     String
  icon            String      @default("rocket")
  salaryMinInr    Int
  salaryMaxInr    Int
  demand          DemandLevel @default(HIGH)
  weeks           Int         @default(12)
  patterns        String[]
  topics          String[]
  companies       String[]
  curriculum      Json
  premium         Boolean     @default(false)
  createdAt       DateTime    @default(now())

  users           UserTrack[]

  @@map("career_tracks")
}

model UserTrack {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId     String
  track       CareerTrack  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  startedAt   DateTime     @default(now())
  currentWeek Int          @default(1)
  isPrimary   Boolean      @default(false)

  @@unique([userId, trackId])
  @@index([userId, isPrimary])
  @@map("user_tracks")
}

// ─── 23. Forum ────────────────────────────────────────────────────

model ForumThread {
  id          String         @id @default(cuid())
  slug        String         @unique
  authorId    String
  author      User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category    ForumCategory
  title       String
  body        String
  pinned      Boolean        @default(false)
  locked      Boolean        @default(false)
  viewCount   Int            @default(0)
  postCount   Int            @default(0)
  lastPostAt  DateTime       @default(now())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  posts       ForumPost[]
  reactions   ForumReaction[]

  @@index([category, pinned, lastPostAt])
  @@map("forum_threads")
}

model ForumPost {
  id          String       @id @default(cuid())
  threadId    String
  thread      ForumThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId    String
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body        String
  parentId    String?
  parent      ForumPost?   @relation("PostReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies     ForumPost[]  @relation("PostReplies")
  createdAt   DateTime     @default(now())
  editedAt    DateTime?

  reactions   ForumReaction[]

  @@index([threadId, createdAt])
  @@map("forum_posts")
}

model ForumReaction {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  threadId    String?
  thread      ForumThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  postId      String?
  post        ForumPost?   @relation(fields: [postId], references: [id], onDelete: Cascade)
  kind        ReactionKind
  createdAt   DateTime     @default(now())

  @@unique([userId, threadId, postId, kind])
  @@index([threadId])
  @@index([postId])
  @@map("forum_reactions")
}

// ─── 24. Internships ──────────────────────────────────────────────

model Internship {
  id             String              @id @default(cuid())
  slug           String              @unique
  company        String
  role           String
  duration       InternshipDuration  @default(MONTHS_3)
  stipendInr     Int
  location       String
  remote         Boolean             @default(false)
  description    String
  applyUrl       String
  eligibility    String?
  ppoConversion  Float?
  deadlineAt     DateTime?
  isActive       Boolean             @default(true)
  postedAt       DateTime            @default(now())

  applications   UserInternship[]

  @@index([role, isActive])
  @@map("internships")
}

model UserInternship {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  internshipId String
  internship   Internship       @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  status       InternshipStatus @default(SAVED)
  notes        String?
  appliedAt    DateTime?
  updatedAt    DateTime         @updatedAt
  createdAt    DateTime         @default(now())

  @@unique([userId, internshipId])
  @@index([userId, status])
  @@map("user_internships")
}

// ─── 25. OA Fingerprint ───────────────────────────────────────────

enum OaSection {
  DSA
  APTITUDE
  CORE_CS
  DEBUG
  ENGLISH
  PSYCHOMETRIC
  SYSTEM_DESIGN
}

model OaReport {
  id          String      @id @default(cuid())
  authorId    String
  author      User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  company     String
  role        String
  driveDate   DateTime
  durationMin Int
  sections    OaSection[]
  difficulty  Difficulty  @default(MEDIUM)
  notes       String      // markdown — pattern of questions, traps, etc.
  patterns    String[]    // e.g. ["sliding-window","bit-manipulation"]
  helpfulCount Int        @default(0)
  createdAt   DateTime    @default(now())

  @@index([company, driveDate])
  @@index([role])
  @@map("oa_reports")
}

enum InterviewOutcome {
  OFFER
  REJECTED
  PENDING
  WITHDRAWN
}

// Crowd-sourced full-loop interview writeups (distinct from OaReport, which is OA-only).
model InterviewExperience {
  id          String           @id @default(cuid())
  authorId    String
  author      User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  company     String
  role        String
  outcome     InterviewOutcome @default(PENDING)
  difficulty  Int              @default(3) // 1–5
  rounds      Int              @default(1)
  body        String           // markdown — round-by-round writeup
  tips        String?
  upvotes     Int              @default(0)
  createdAt   DateTime         @default(now())

  @@index([company, createdAt])
  @@map("interview_experiences")
}

// ─── 26. Mentor payouts (Razorpay Connect transfers) ──────────────

enum PayoutStatus {
  PENDING
  PROCESSED
  FAILED
  REVERSED
}

model MentorPayout {
  id              String       @id @default(cuid())
  mentorId        String
  mentor          Mentor       @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  mockSessionId   String       @unique
  amountInr       Int          // payout to mentor in paisa (80% of session price)
  platformFeeInr  Int          // EYF cut in paisa (20%)
  status          PayoutStatus @default(PENDING)
  razorpayTransferId String?   @unique
  errorMessage    String?
  createdAt       DateTime     @default(now())
  processedAt     DateTime?

  @@index([mentorId, status])
  @@map("mentor_payouts")
}

// ─── 27. Pressure Training (Phase 4 Week 26–27) ───────────────────

enum PressureLevel {
  LOW     // 1.5x time
  NORMAL  // 1x time
  HIGH    // 0.7x time
  EXTREME // 0.5x time + countdown sounds
}

model PressureSession {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId       String?
  problem         Problem?      @relation(fields: [problemId], references: [id], onDelete: SetNull)
  level           PressureLevel @default(NORMAL)
  targetSeconds   Int
  actualSeconds   Int?
  completed       Boolean       @default(false)
  // Self-reported anxiety 1-10 before and after.
  anxietyBefore   Int?
  anxietyAfter    Int?
  // 1-10 confidence in the solution at submit time.
  confidence      Int?
  startedAt       DateTime      @default(now())
  endedAt         DateTime?

  @@index([userId, startedAt])
  @@map("pressure_sessions")
}

// ─── 28. Peer mock matchmaking ────────────────────────────────────

enum PeerQueueStatus {
  WAITING
  MATCHED
  CANCELED
}

model PeerQueue {
  id          String          @id @default(cuid())
  userId      String          @unique
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      PeerQueueStatus @default(WAITING)
  problemFocus String?
  joinedAt    DateTime        @default(now())
  matchedMockId String?       @unique

  @@index([status, joinedAt])
  @@map("peer_queue")
}

// ─── 29. Push tokens (Expo / web) ─────────────────────────────────

enum PushPlatform {
  IOS
  ANDROID
  WEB
}

model PushToken {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform    PushPlatform
  token       String       @unique
  // ISO 639-1 language preference for notification copy.
  lang        String       @default("en")
  createdAt   DateTime     @default(now())
  lastSeenAt  DateTime     @default(now())

  @@index([userId])
  @@map("push_tokens")
}

// ─── MCQ Tests ────────────────────────────────────────────────────
// Timed, sectioned multiple-choice practice (aptitude / verbal / technical),
// optionally filtered to a company's pattern. Content lives in an editorial
// bank (src/lib/mcq-bank.ts); only attempts are persisted here — same approach
// as AssessmentSession/CognitiveSession.

enum McqCategory {
  APTITUDE  // quant, data interpretation
  LOGICAL   // reasoning, series, puzzles
  VERBAL    // grammar, RC, para-jumbles, vocabulary
  TECHNICAL // OS / DBMS / CN / OOP / DSA theory
}

model McqAttempt {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        McqCategory
  company         String?     // optional company-pattern filter, e.g. "TCS", "Infosys"
  totalQuestions  Int
  correctAnswers  Int
  score           Int         // 0–100
  durationSeconds Int
  // Per-question review payload: [{ questionId, chosen, correctIndex }]
  detail          Json
  completedAt     DateTime    @default(now())

  @@index([userId, category])
  @@index([userId, completedAt])
  @@map("mcq_attempts")
}

// ─── Communication drills ─────────────────────────────────────────
// Spoken-English / HR / behavioural practice: the learner answers a prompt
// (typed or transcribed via Whisper) and Claude returns structured feedback.
// Prompt content is editorial (src/lib/communication-bank.ts); attempts persist.

enum CommunicationKind {
  INTRO       // "Tell me about yourself", walk-through-resume
  HR          // motivation, strengths/weaknesses, 5-year plan
  BEHAVIORAL  // STAR: "tell me about a time…"
  SITUATIONAL // hypothetical judgement / conflict scenarios
}

model CommunicationDrill {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  promptId        String            // references a prompt in the editorial bank
  kind            CommunicationKind
  transcript      String            // the learner's answer (typed or transcribed)
  score           Int               // 0–100 overall
  feedback        Json              // { overallScore, dimensions{}, strengths[], improvements[], fillerWords[], modelAnswer }
  durationSeconds Int               @default(0)
  createdAt       DateTime          @default(now())

  @@index([userId, kind])
  @@index([userId, createdAt])
  @@map("communication_drills")
}

// ─── Project interview prep ───────────────────────────────────────
// A student feeds a project (a started UserProject or a custom one) and Claude
// generates the interview grilling they'll face on it — questions, what each
// probes, and how to approach — plus red-flags and STAR story hooks.

model ProjectPrep {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectTitle String
  summary      String   // one-line description used to ground generation
  techStack    String[]
  questions    Json     // [{ category, question, testing, approach }]
  tips         Json     // { redFlags: string[], starHooks: string[] }
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@map("project_preps")
}

// ─── Admin audit log ──────────────────────────────────────────────
// Who did what in the staff back-office. Written best-effort by admin
// mutations; viewing is gated on view:analytics (ADMIN only).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorEmail String
  action     String   // create | update | delete | role | plan | status
  entity     String   // problem | job | career-track | user
  entityId   String
  summary    String
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entity])
  @@map("audit_logs")
}

// ─── Active sessions (account-sharing control) ────────────────────
// One row per active device/login. The JWT carries this row's id as `sid`;
// the auth middleware rejects tokens whose session was evicted. Login caps
// concurrent sessions per user, evicting the oldest — so a shared account
// can't be used on unlimited devices at once.
model UserSession {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("user_sessions")
}

// ─── LMS + B2B (the scaling wedge: white-label LMS ↔ internship supply) ───

enum CourseAudience {
  STAFF      // org trains its own employees
  CANDIDATE  // org screens EYF students as a pre-internship filter
  BOTH
}

// ─── Enterprise platform (PRD specs/EYF_Enterprise_Learning_Platform_PRD.md §13) ───

enum OrgPlan {
  TRIAL
  TEAM
  BUSINESS
  ENTERPRISE
  EDUCATION
}

enum OrgRole {
  OWNER
  ADMIN
  HR
  RECRUITER
  LND
  ENG_MANAGER
  INSTRUCTOR
  MENTOR
  REVIEWER
  MEMBER
  INTERN
}

enum OrgMemberStatus {
  ACTIVE
  SUSPENDED
  OFFBOARDED
}

model Organization {
  id            String           @id @default(cuid())
  name          String
  slug          String           @unique
  accessCode    String           @unique // legacy employer-portal login (pre-membership)
  logoUrl       String?
  brandColor    String?
  plan          OrgPlan          @default(TRIAL)
  seatsLicensed Int              @default(10)
  settings      Json?
  createdAt     DateTime         @default(now())
  courses       Course[]
  internships   InternshipSlot[]
  members       OrgMember[]
  departments   Department[]
  teams         Team[]
  invites       OrgInvite[]
  learningPaths LearningPath[]
  cohorts       Cohort[]
  roleBars      RoleBar[]
  assessmentBlueprints AssessmentBlueprint[]
  assessmentRuns AssessmentRun[]
  certificateTemplates CertificateTemplate[]
  requisitions  JobRequisition[]
  apiKeys       ApiKey[]
  webhooks      WebhookEndpoint[]
  @@map("organizations")
}

// Membership = the identity spine of the enterprise platform. A user can be
// a member of many orgs with different role sets (PRD §9).
model OrgMember {
  id           String          @id @default(cuid())
  orgId        String
  org          Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles        OrgRole[]
  departmentId String?
  department   Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  title        String?
  status       OrgMemberStatus @default(ACTIVE)
  joinedAt     DateTime        @default(now())
  teams        TeamMember[]
  cohortEnrollments CohortEnrollment[]

  @@unique([orgId, userId])
  @@index([orgId, departmentId])
  @@map("org_members")
}

model Department {
  id       String       @id @default(cuid())
  orgId    String
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name     String
  parentId String?
  parent   Department?  @relation("DeptTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[] @relation("DeptTree")
  members  OrgMember[]
  teams    Team[]

  @@index([orgId])
  @@map("org_departments")
}

model Team {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  name         String
  members      TeamMember[]

  @@index([orgId])
  @@map("org_teams")
}

model TeamMember {
  teamId   String
  team     Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  memberId String
  member   OrgMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([teamId, memberId])
  @@map("org_team_members")
}

// ─── Enterprise: API keys + webhooks (PRD §24/§14) ─────────────────
model ApiKey {
  id         String    @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name       String
  prefix     String    @unique // shown to the user (eyf_live_xxxx); the rest is hashed
  hashedKey  String // sha-256 hash of the full key — the raw key is shown ONCE
  scopes     String[] // subset of org capabilities
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  @@index([orgId])
  @@map("org_api_keys")
}

model WebhookEndpoint {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  url       String
  secret    String // HMAC signing secret
  events    String[] // event names to deliver
  active    Boolean  @default(true)
  failCount Int      @default(0)
  createdAt DateTime @default(now())
  deliveries WebhookDelivery[]
  @@index([orgId])
  @@map("org_webhook_endpoints")
}

model WebhookDelivery {
  id         String          @id @default(cuid())
  endpointId String
  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event      String
  payload    Json
  status     String          @default("pending") // pending | delivered | failed
  attempts   Int             @default(0)
  lastAt     DateTime?
  createdAt  DateTime        @default(now())
  @@index([endpointId, createdAt])
  @@map("org_webhook_deliveries")
}

// ─── Hiring (PRD §21) — consent-first evidence-based hiring from the pool.
enum TalentScope {
  POOL_ANON // searchable, identity hidden until the candidate accepts an interview
  POOL_FULL // fully visible to recruiters
}

enum RequisitionStatus {
  OPEN
  PAUSED
  CLOSED
}

enum PipelineStage {
  SOURCED
  SCREEN
  ASSESSMENT
  INTERVIEW
  DECISION
  OFFER
  HIRED
  REJECTED
}

enum CandidateSource {
  ELITE_POOL
  INTERNAL
  APPLY
  REFERRAL
}

// A student opts into the talent pool. One row per user (unique); revocable.
model TalentConsent {
  id        String      @id @default(cuid())
  userId    String      @unique
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope     TalentScope @default(POOL_ANON)
  grantedAt DateTime    @default(now())
  revokedAt DateTime?
  @@map("talent_consents")
}

model JobRequisition {
  id               String             @id @default(cuid())
  orgId            String
  org              Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title            String
  roleBarId        String?
  minReadiness     Int                @default(0)
  status           RequisitionStatus  @default(OPEN)
  hiringManagerId  String?
  createdAt        DateTime           @default(now())
  candidates       PipelineCandidate[]
  offers           Offer[]
  @@index([orgId, status])
  @@map("org_requisitions")
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

// Offer with a two-person chain (PRD §9/§21): a recruiter drafts (hire:pipeline),
// someone with hire:offer sends, the candidate responds. On accept, the hire's
// B2C profile becomes an org membership (F10 — campus→career spine).
model Offer {
  id           String       @id @default(cuid())
  reqId        String
  req          JobRequisition @relation(fields: [reqId], references: [id], onDelete: Cascade)
  userId       String // the candidate (a platform user)
  title        String
  ctcInr       Int          @default(0) // annual, rupees
  startDate    DateTime?
  status       OfferStatus  @default(DRAFT)
  draftedById  String // OrgMember who drafted
  sentById     String? // OrgMember who approved+sent (hire:offer)
  sentAt       DateTime?
  respondedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now()) @updatedAt
  @@unique([reqId, userId])
  @@index([userId, status])
  @@map("org_offers")
}

model PipelineCandidate {
  id               String          @id @default(cuid())
  reqId            String
  req              JobRequisition  @relation(fields: [reqId], references: [id], onDelete: Cascade)
  userId           String
  source           CandidateSource @default(ELITE_POOL)
  stage            PipelineStage   @default(SOURCED)
  fitScore         Int? // barFit / readiness at time of sourcing
  note             String?
  evidenceSnapshot Json? // frozen evidence summary when sourced
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt
  @@unique([reqId, userId])
  @@index([reqId, stage])
  @@map("org_pipeline_candidates")
}

// ─── Assessment engine (PRD §17/18) — reuses McqBankQuestion + scoring;
// emits higher-trust ASSESSMENT evidence into the Skill Ledger on submit.
enum AssessmentPurpose {
  TRAINING
  CERTIFICATION
  HIRING
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

model AssessmentBlueprint {
  id            String          @id @default(cuid())
  orgId         String
  org           Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name          String
  skillId       String? // the skill this run measures → evidence target
  category      McqCategory     @default(TECHNICAL) // bank section to draw from
  questionCount Int             @default(10)
  durationMin   Int             @default(20)
  passingScore  Int             @default(60)
  proctorLevel  Int             @default(1) // 0 honor · 1 telemetry (L2/L3 later)
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  runs          AssessmentRun[]
  @@index([orgId])
  @@map("org_assessment_blueprints")
}

model AssessmentRun {
  id          String              @id @default(cuid())
  orgId       String
  org         Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  blueprintId String
  blueprint   AssessmentBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  purpose     AssessmentPurpose   @default(TRAINING)
  windowStart DateTime            @default(now())
  windowEnd   DateTime?
  createdAt   DateTime            @default(now())
  attempts    AssessmentAttempt[]
  @@index([orgId])
  @@map("org_assessment_runs")
}

model AssessmentAttempt {
  id             String        @id @default(cuid())
  runId          String
  run            AssessmentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  userId         String
  questionIds    String[] // frozen draw at start (answers never sent to client)
  answers        Json? // [{ questionId, choice }] submitted
  score          Int? // 0..100
  integrityScore Int           @default(100)
  proctorEvents  Int           @default(0) // L1 tab-blur/fullscreen-exit tally
  status         AttemptStatus @default(IN_PROGRESS)
  startedAt      DateTime      @default(now())
  submittedAt    DateTime?
  @@unique([runId, userId])
  @@index([runId])
  @@map("org_assessment_attempts")
}

// ─── Skill Ledger (PRD §15.13 — the evidence layer / moat) ─────────
// Global skill taxonomy; per-person append-only evidence from every source;
// a materialized decay-weighted snapshot; role bars to measure against.
enum EvidenceSource {
  LESSON
  ASSESSMENT
  JUDGED_CODE
  PROJECT_REVIEW
  MOCK
  CERT
  MENTOR_RATING
  IMPORT
}

model Skill {
  id       String   @id @default(cuid())
  slug     String   @unique
  name     String
  category String?
  parentId String?
  parent   Skill?   @relation("SkillTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Skill[]  @relation("SkillTree")
  lessons  Lesson[]
  @@map("skills")
}

// One immutable observation that a user demonstrated a skill at some level.
// Never updated — the ledger is the sum of history, decayed by recency.
model SkillEvidence {
  id              String         @id @default(cuid())
  userId          String
  orgId           String? // null = platform-wide (B2C activity); set = earned inside an org
  skillId         String
  level           Int // 0..100 demonstrated on this occasion
  weight          Float          @default(1) // source trust (lesson < assessment < judged code)
  sourceType      EvidenceSource
  sourceId        String?
  decayHalfLifeDays Int          @default(180)
  createdAt       DateTime       @default(now())
  @@index([userId, skillId])
  @@index([orgId, skillId])
  @@map("skill_evidence")
}

// Materialized ledger — recomputed from evidence on write (a worker takes over
// at scale). Unique per (user, org-context, skill).
model SkillSnapshot {
  id            String   @id @default(cuid())
  userId        String
  orgId         String?
  skillId       String
  level         Int
  evidenceCount Int      @default(0)
  computedAt    DateTime @default(now())
  @@unique([userId, orgId, skillId])
  @@index([orgId, skillId])
  @@map("skill_snapshots")
}

model RoleBar {
  id          String        @id @default(cuid())
  orgId       String
  org         Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  basedOnTier String?
  skills      RoleBarSkill[]
  createdAt   DateTime      @default(now())
  @@index([orgId])
  @@map("org_role_bars")
}

model RoleBarSkill {
  id            String  @id @default(cuid())
  roleBarId     String
  roleBar       RoleBar @relation(fields: [roleBarId], references: [id], onDelete: Cascade)
  skillId       String
  requiredLevel Int // 0..100 bar to clear
  weight        Float   @default(1)
  @@unique([roleBarId, skillId])
  @@map("org_role_bar_skills")
}

// Learning paths (PRD §15.12) — ordered programs composed of courses (more
// item types arrive with the assessment engine). Cohorts run a path against
// an audience with dates; enrollment rows carry the funnel + stuck state.
enum PathItemType {
  COURSE
}

enum CohortEnrollStatus {
  ENROLLED
  COMPLETED
  DROPPED
}

model LearningPath {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title       String
  description String       @default("")
  published   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt
  items       PathItem[]
  cohorts     Cohort[]

  @@index([orgId])
  @@map("org_learning_paths")
}

model PathItem {
  id         String       @id @default(cuid())
  pathId     String
  path       LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  itemType   PathItemType @default(COURSE)
  courseId   String
  course     Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  orderIndex Int          @default(0)
  required   Boolean      @default(true)

  @@unique([pathId, courseId])
  @@map("org_path_items")
}

model Cohort {
  id          String             @id @default(cuid())
  orgId       String
  org         Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  pathId      String
  path        LearningPath       @relation(fields: [pathId], references: [id], onDelete: Cascade)
  name        String
  startsAt    DateTime
  endsAt      DateTime?
  createdAt   DateTime           @default(now())
  enrollments CohortEnrollment[]

  @@index([orgId])
  @@map("org_cohorts")
}

model CohortEnrollment {
  id             String             @id @default(cuid())
  cohortId       String
  cohort         Cohort             @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  memberId       String
  member         OrgMember          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status         CohortEnrollStatus @default(ENROLLED)
  progressPct    Int                @default(0)
  lastActivityAt DateTime?
  stuckFlag      Boolean            @default(false)
  enrolledAt     DateTime           @default(now())

  @@unique([cohortId, memberId])
  @@index([cohortId, stuckFlag])
  @@map("org_cohort_enrollments")
}

// Usage metering (PRD §23) — one row per org × metric × month. Incremented
// via atomic upsert; billing and limit checks read the current period.
model UsageCounter {
  id     String @id @default(cuid())
  orgId  String
  metric String // exec_minutes | ai_credits | proctored_attempts | storage_mb | invites_sent
  period String // "YYYY-MM"
  value  Int    @default(0)

  @@unique([orgId, metric, period])
  @@index([orgId, period])
  @@map("org_usage_counters")
}

model OrgInvite {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email       String
  roles       OrgRole[]
  token       String       @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime     @default(now())

  @@index([orgId])
  @@map("org_invites")
}

// Course lifecycle (PRD §16): DRAFT → IN_REVIEW → PUBLISHED → ARCHIVED.
// `published` stays in sync (status == PUBLISHED) for the legacy org portal.
enum CourseStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  RICH_TEXT
  VIDEO
  JUDGED_CODE
  QUIZ_INLINE
  EMBED
  FILE
}

model Course {
  id             String          @id @default(cuid())
  orgId          String
  org            Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title          String
  description    String          @default("")
  audience       CourseAudience  @default(BOTH)
  status         CourseStatus    @default(DRAFT)
  published      Boolean         @default(false) // legacy mirror of status
  version        Int             @default(1)
  estMinutes     Int             @default(0)
  authorMemberId String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt
  lessons        Lesson[]
  enrollments    Enrollment[]
  versions       CourseVersion[]
  pathItems      PathItem[]
  @@index([orgId, status])
  @@map("lms_courses")
}

// Immutable snapshot taken at every publish — running cohorts pin a version;
// rollback = republish an old snapshot (PRD §16).
model CourseVersion {
  id            String   @id @default(cuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  version       Int
  snapshot      Json // { title, description, lessons: [{title,type,blocks,estMinutes,orderIndex}] }
  publishedById String
  publishedAt   DateTime @default(now())
  @@unique([courseId, version])
  @@map("lms_course_versions")
}

model Lesson {
  id         String     @id @default(cuid())
  courseId   String
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title      String
  content    String     @default("") // legacy plain text (pre-blocks)
  type       LessonType @default(RICH_TEXT)
  blocks     Json? // ordered block array (PRD §16 block model)
  estMinutes Int        @default(5)
  orderIndex Int        @default(0)
  skillId    String?
  skill      Skill?     @relation(fields: [skillId], references: [id], onDelete: SetNull)
  skillLevel Int        @default(60) // evidence level emitted when a tagged lesson is completed
  progress   LessonProgress[]
  @@index([courseId])
  @@map("lms_lessons")
}

model InternshipSlot {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role      String
  location  String?
  stipend   String?
  seats     Int          @default(1)
  eliteOnly Boolean      @default(true) // the flywheel — Elite students get access
  openUntil DateTime?
  createdAt DateTime     @default(now())
  @@index([orgId])
  @@map("internship_slots")
}

// Webhook idempotency ledger — a processed provider event is recorded here (by
// its unique event id); a duplicate delivery hits the unique constraint and no-ops.
model WebhookEvent {
  id        String   @id // the provider's event id (e.g. x-razorpay-event-id)
  provider  String
  type      String
  createdAt DateTime @default(now())
  @@map("webhook_events")
}

// A student's enrollment in an LMS course. userId is a plain string (queried
// directly); no User FK to avoid touching the large User model.
model Enrollment {
  id         String   @id @default(cuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId     String
  enrolledAt DateTime @default(now())
  @@unique([courseId, userId])
  @@index([userId])
  @@map("lms_enrollments")
}

// A student completing a lesson. Presence of a row = completed.
model LessonProgress {
  id          String   @id @default(cuid())
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId      String
  completedAt DateTime @default(now())
  @@unique([lessonId, userId])
  @@index([userId])
  @@map("lms_lesson_progress")
}
